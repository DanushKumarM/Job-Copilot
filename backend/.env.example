# Copy to .env and adjust. Never commit .env.
JOBCOPILOT_DATABASE_URL=postgresql+psycopg://postgres@localhost:5433/jobcopilot
JOBCOPILOT_TEST_DATABASE_URL=postgresql+psycopg://postgres@localhost:5433/jobcopilot_test
JOBCOPILOT_FILE_ROOT=../data/files
JOBCOPILOT_OWNER_EMAIL=you@example.com
JOBCOPILOT_AUTH_COOKIE_SECURE=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JOBCOPILOT_API_TOKEN=
# OAuth client JSON (Desktop app) from Google Cloud Console; see README "Connecting Gmail".
JOBCOPILOT_GMAIL_CLIENT_SECRET_FILE=
JOBCOPILOT_GMAIL_INITIAL_LOOKBACK_DAYS=30
JOBCOPILOT_LLM_PROVIDER=ollama
JOBCOPILOT_OLLAMA_URL=http://localhost:11434
JOBCOPILOT_OLLAMA_MODEL=llama3.1:8b
JOBCOPILOT_LLM_MONTHLY_CAP_INR=0
# Hosted model (any OpenAI-compatible API: Groq, Gemini's OpenAI endpoint, Azure OpenAI). Optional.
JOBCOPILOT_HOSTED_LLM_URL=https://api.groq.com/openai/v1
JOBCOPILOT_HOSTED_LLM_API_KEY=
JOBCOPILOT_HOSTED_LLM_MODEL=
# Free tiers may train on inputs: keep False unless the provider's terms say otherwise.
JOBCOPILOT_HOSTED_LLM_ALLOWS_PERSONAL_DATA=false
JOBCOPILOT_HOSTED_LLM_INR_PER_1K_TOKENS=0
# Gemini provider (select with JOBCOPILOT_LLM_PROVIDER=gemini).
JOBCOPILOT_GEMINI_API_KEY=
JOBCOPILOT_GEMINI_MODEL=gemini-2.0-flash
JOBCOPILOT_GEMINI_ALLOWS_PERSONAL_DATA=false
JOBCOPILOT_GEMINI_INR_PER_1K_TOKENS=0
# Requirement extraction: rules (offline) or llm (the worker refines with a model; job text is public).
JOBCOPILOT_REQUIREMENT_EXTRACTOR=rules
JOBCOPILOT_EXTRACTION_PROVIDER=ollama
# TrueType font for PDFs; empty = Arial (Windows) or DejaVu Sans (Linux).
JOBCOPILOT_PDF_FONT=
# Optional LaTeX template. Uses Jinja-style placeholders such as {{ full_name }} and {{ highlights }}.
# Requires the configured engine (default: pdflatex) to be installed and available on PATH.
JOBCOPILOT_LATEX_TEMPLATE=
JOBCOPILOT_LATEX_ENGINE=pdflatex
