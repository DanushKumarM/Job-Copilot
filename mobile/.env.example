# Job-Copilot Mobile Environment Configuration

# Android Emulator (points to host machine):
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Physical Android Device on same Wi-Fi/LAN (replace with your development machine IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8000

# HTTPS Production Deployment:
# EXPO_PUBLIC_API_URL=https://jobcopilot.yourdomain.com
